{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"],
    "baseUrl": ".",
    "paths": {
      "@ipd/contracts": ["packages/contracts/src/index.ts"],
      "@ipd/contracts/*": ["packages/contracts/src/*"]
    }
  },
  "include": ["apps/api/src", "packages/contracts/src", "scripts", "benchmarks"]
}
